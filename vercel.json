{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "feature/intelligence-v1": false,
      "feature/focus-workflow-v2": false,
      "feature/salesforce-contact-queue": false,
      "feature/company-research-feedback": false,
      "feature/call-ready-preparation": false,
      "feature/opportunity-queues": false,
      "fix/focus-call-controls": false,
      "fix/pinned-phone-copy": false,
      "fix/compact-focus-screen": false,
      "fix/call-task-clarity": false,
      "fix/restore-cold-call-toggle": false,
      "fix/focus-performance": false,
      "feat/pre-search-screening": false,
      "feat/free-company-context": false,
      "feat/hmrc-first-qualification": false,
      "feat/research-budget-ranking": false,
      "fix/focus-outreach-only": false,
      "feat/open-opportunities": false,
      "feat/opportunity-attention": false,
      "feat/daily-email-merge": false,
      "feat/ready-email-copy": false,
      "fix/callback-retry-context": false,
      "feat/strict-lusha-intake": false,
      "fix/hmrc-provider-reliability": false
    }
  },
  "functions": {
    "api/lead-research.ts": {
      "maxDuration": 90
    }
  }
}
